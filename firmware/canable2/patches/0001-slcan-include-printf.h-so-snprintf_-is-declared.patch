Subject: [PATCH 1/3] slcan: include printf.h so snprintf_ is declared

GCC 14 and later treat implicit function declarations as errors, so
b158aa7 no longer builds without this.
---
 src/slcan.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/slcan.c b/src/slcan.c
index 4cdf4c0..72edfb4 100644
--- a/src/slcan.c
+++ b/src/slcan.c
@@ -6,6 +6,7 @@
 #include <string.h>
 #include "can.h"
 #include "error.h"
+#include "printf.h"
 #include "slcan.h"
 #include "usbd_cdc_if.h"
 
