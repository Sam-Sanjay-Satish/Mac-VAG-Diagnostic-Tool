From 109c5219360880b3e1dd6ded9ef6e3902ea7c38e Mon Sep 17 00:00:00 2001
From: Sam Sanjay Satish <samsanjay@uvic.ca>
Date: Thu, 5 Nov 2026 05:16:51 -0700
Subject: [PATCH 3/3] Add 'X' command: restart into the ROM DFU boot loader

Lets the firmware be updated over USB without opening the case to
bridge the BOOT pins. Accepted only as the bare command "X" and only
while off the bus. It sets a magic value in TAMP backup register 0 and
resets; main() checks it before any initialisation and jumps to the
STM32 system memory boot loader from a clean reset state.

Also stops 'X' falling through to the frame parser: in stock firmware
"X..." was parsed and transmitted as a CAN data frame.
---
 inc/system.h |  2 ++
 src/main.c   |  3 +++
 src/slcan.c  | 12 +++++++---
 src/system.c | 63 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 77 insertions(+), 3 deletions(-)

diff --git a/inc/system.h b/inc/system.h
index 020c01b..23ce909 100644
--- a/inc/system.h
+++ b/inc/system.h
@@ -7,6 +7,8 @@ void system_init(void);
 void system_irq_enable(void);
 void system_irq_disable(void);
 void system_hex32(char *out, uint32_t val);
+void system_enter_bootloader(void);
+void system_bootloader_check(void);
 
 
 #endif
diff --git a/src/main.c b/src/main.c
index b59edcb..c8dd851 100644
--- a/src/main.c
+++ b/src/main.c
@@ -14,6 +14,9 @@
 
 int main(void)
 {
+    // Restart into the ROM boot loader if the "X" command asked for it
+    system_bootloader_check();
+
     // Initialize peripherals
     system_init();
     can_init();
